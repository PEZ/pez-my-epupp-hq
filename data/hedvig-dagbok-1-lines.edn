    :left 154.8,
    :right 440.79999999999995,
    :size 10}
   {:text
    "att roa hertigen på bästa sätt . Slutligen framträdde en landsorts -",
    :top 568.8,
    :left 154.3,
    :right 440.6,
    :size 11}]}
